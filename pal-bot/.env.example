# Copy this file to .env and fill it in. Never commit .env.

# 1. Telegram: create the bot with @BotFather (/newbot) and paste its token.
TELEGRAM_BOT_TOKEN=
# Leave empty at first. Send /start to your bot, it replies with your id; put it here and restart.
TELEGRAM_OWNER_ID=
OWNER_NAME=Lye

# 2. Claude (thinking, chat, minutes, mail triage): https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 3. Voice notes and meeting audio -> text (English / 中文 / BM). Same key as your meeting-app.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# 4. Gmail inbox that receives your iPhone calendar feed and forwarded Lotus Notes mail.
#    App password: Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Lotus Notes rule forwards to <you>+notes@gmail.com
NOTES_TAG=+notes
# Subject the iPhone Shortcut uses
AGENDA_SUBJECT=PAL AGENDA
MAIL_POLL_MINUTES=5

# Where Pal keeps its data (use a persistent volume when hosting).
DATA_DIR=./data
TZ=Asia/Kuala_Lumpur
# Voice notes longer than this (seconds) become minutes instead of a chat message.
SHORT_VOICE_SECONDS=90
MEETING_HEADS_UP_MINUTES=20
